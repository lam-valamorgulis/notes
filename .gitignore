.DS_Store

# Working copy of the public site repo (lam-valamorgulis/notes).
# Created and updated by ./deploy-site.sh — never commit it here.
.site/

# Staged copy of a single course, uploaded to Vercel by its own
# deploy-vercel.sh. Rebuilt from scratch on every run, so it is never committed.
.vercel-site/

# Written by the Vercel CLI. Holds the id of the linked Vercel project.
.vercel/

# --- The runnable Project inside shopify-tech-lead/ -------------------------
# Secrets and build output never enter git, not even this private repo. Once a
# token is in git history it cannot be removed by a later delete commit — the
# only fix is a fresh repo, which is why this is a hard rule and not a habit.
.env
.env.*
!.env.example
node_modules/
dist/
build/
coverage/

# Local Postgres data if docker-compose is pointed at a bind mount.
shopify-tech-lead/project/**/pgdata/
